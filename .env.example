# Copy to .env and adjust as needed. Every value is optional.
# Never commit a real .env file - it is ignored by .gitignore.

# Where the interaction dataset lives.
RECOMSENSE_INTERACTIONS_PATH=data/interactions.csv

# Where the trained model bundle is written and read from.
RECOMSENSE_ARTIFACT_PATH=artifacts/recommender.pkl

# ALS hyperparameters.
RECOMSENSE_FACTORS=50
RECOMSENSE_ITERATIONS=20
RECOMSENSE_REGULARIZATION=0.05
RECOMSENSE_RANDOM_STATE=42

# API defaults and limits for Top-N.
RECOMSENSE_DEFAULT_TOP_N=5
RECOMSENSE_MAX_TOP_N=50

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
RECOMSENSE_LOG_LEVEL=INFO
